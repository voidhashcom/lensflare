{
  "name": "@lensflare/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "scripts": {
    "dev": "concurrently -k -s first -n web,bundle,electron \"pnpm --dir ../web run dev\" \"pnpm run dev:bundle\" \"pnpm run dev:electron\"",
    "dev:bundle": "vp pack --watch",
    "dev:desktop": "pnpm run dev",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 dist/index.cjs && env -u ELECTRON_RUN_AS_NODE LENSFLARE_DESKTOP_DEV=1 electronmon .",
    "build": "vp pack && env -u ELECTRON_RUN_AS_NODE electron-builder",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "typecheck": "tsc --noEmit",
    "test": "vp test --passWithNoTests",
    "clean": "rm -rf dist artifacts"
  },
  "dependencies": {
    "@duckdb/node-api": "catalog:",
    "@lensflare/local-server": "workspace:*",
    "@lensflare/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "concurrently": "^9.2.1",
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wait-on": "^9.0.5"
  }
}
