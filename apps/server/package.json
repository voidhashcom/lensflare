{
  "name": "@lensflare/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm exec vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lensflare/local-server": "workspace:*",
    "@lensflare/shared": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
