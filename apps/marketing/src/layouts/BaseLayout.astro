---
/**
 * Root document shell for every marketing page. Owns `<head>` metadata, font
 * loading, and the single `<slot />` the page renders into. The visual
 * language matches the Paper design — light only, Inter for prose, Geist for
 * the small UI label on the GitHub button — so there is no theme-init script
 * or scroll-reveal observer to bootstrap.
 */
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Lensflare — Development observability stack for humans and agents",
  description = "Free, open-source development observability stack. You and your agent can now move beyond static code to see what actually happened at runtime.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / social -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!--
      Inter for prose & headlines; Geist for the small GitHub label per the
      Paper design. Both come from Google Fonts. We pull only the weights the
      page actually uses to keep the font payload tight.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Inter:wght@400;500&display=swap"
    />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
