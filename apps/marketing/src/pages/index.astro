---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { Hero } from "../components/Hero";
import { AppShowcase } from "../components/AppShowcase";
import { Footer } from "../components/Footer";
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <!--
      The AppShowcase renders a WebGL fluted-glass shader, so it must hydrate
      on the client. `client:load` is fine here because it's the visual focal
      point of the page — we don't want to wait for it to scroll into view.
    -->
    <AppShowcase client:load />
  </main>
  <Footer />
</BaseLayout>
