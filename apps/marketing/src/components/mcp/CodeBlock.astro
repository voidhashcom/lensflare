---
/**
 * Static, copy-friendly code block for the MCP docs page. No client island —
 * the page already ships zero JS, so the "click the line, hit ⌘C" affordance
 * is intentional. The optional `filename` prop renders a small label above
 * the block so the user knows which config file the snippet should land in.
 */
import { loadHighlighter, SHIKI_LIGHT_THEME } from "../../lib/shiki";

interface Props {
  code: string;
  filename?: string | undefined;
  language?: string | undefined;
}

const { code, filename, language } = Astro.props;
const snippetLanguage = language === "shell" ? "bash" : "json";

let html: string | null = null;

try {
  const highlighter = await loadHighlighter();
  html = highlighter.codeToHtml(code, {
    lang: snippetLanguage,
    theme: SHIKI_LIGHT_THEME,
  });
} catch {
  html = null;
}
---

<div class="flex flex-col gap-2">
  {
    filename ? (
      <div class="font-[family-name:ui-monospace,_SFMono-Regular,_Menlo,_monospace] text-[12px] leading-[150%] text-muted-foreground">
        <span>{filename}</span>
      </div>
    ) : null
  }
  {
    html ? (
      <Fragment set:html={html} />
    ) : (
      <pre
        class="overflow-x-auto rounded-md border border-border bg-[#fafafa] px-4 py-3 font-[family-name:ui-monospace,_SFMono-Regular,_Menlo,_monospace] text-[12.5px] leading-[1.55] text-foreground"
      ><code>{code}</code></pre>
    )
  }
</div>

<style>
  :global(pre.shiki) {
    margin: 0;
    overflow-x: auto;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: #fafafa !important;
    padding: 0.75rem 1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12.5px;
    line-height: 1.55;
  }

  :global(pre.shiki code) {
    font-family: inherit;
  }
</style>
