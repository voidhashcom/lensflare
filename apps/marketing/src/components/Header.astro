---
/**
 * Top chrome — full-width band with a hairline bottom rule, plus the inner
 * 1152px container framed by hairline vertical rules so the column lines line
 * up with every section below. The wordmark sits on the left, a small GitHub
 * icon-and-label on the right. Matches the Paper design 1:1.
 */
import { GITHUB_REPO_URL } from "../lib/links";
import { GithubIcon } from "./icons/GithubIcon";
import { Logo } from "./Logo";
---

<header class="w-full border-b border-border bg-background">
  <div
    class="mx-auto flex h-14 max-w-[1152px] items-center border-x border-border px-8"
  >
    <a
      href="/"
      class="flex items-center gap-2 text-[var(--logo)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--logo)]"
      aria-label="Lensflare — home"
    >
      <Logo className="h-5 w-auto" />
    </a>

    <a
      href={GITHUB_REPO_URL}
      target="_blank"
      rel="noreferrer noopener"
      class="ml-auto flex h-9 items-center gap-2 rounded-md px-3 font-[family-name:var(--font-geist)] text-[12px] leading-[16px] text-foreground transition-colors hover:bg-[#f4f4f4]"
    >
      <GithubIcon className="h-3.5 w-3.5" />
      <span>Github</span>
    </a>
  </div>
</header>
