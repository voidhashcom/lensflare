{
  "name": "lensflare",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "turbo run dev --filter=@lensflare/server --filter=@lensflare/web",
    "dev:server": "turbo run dev --filter=@lensflare/server",
    "dev:web": "turbo run dev --filter=@lensflare/web",
    "dev:desktop": "turbo run dev --filter=@lensflare/web --filter=@lensflare/desktop",
    "build": "turbo run build",
    "build:desktop": "turbo run build --filter=@lensflare/desktop",
    "prepare": "effect-language-service patch",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/artifacts"
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "effect-solutions": "^0.5.2",
    "turbo": "^2.5.8",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
